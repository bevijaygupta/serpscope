{
  "framework": "vite",
  "installCommand": "cd frontend && npm ci",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "^(serpscope-six|serpscope-serpscope|serpscope-3zidgh2ls-serpscope|serpscope-git-main-serpscope|serpscope-q0i0jcyue-serpscope)\\.vercel\\.app$"
        }
      ],
      "destination": "https://serpscopelive.vercel.app",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "^(serpscope-six|serpscope-serpscope|serpscope-3zidgh2ls-serpscope|serpscope-git-main-serpscope|serpscope-q0i0jcyue-serpscope)\\.vercel\\.app$"
        }
      ],
      "destination": "https://serpscopelive.vercel.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://serpscope-api.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
