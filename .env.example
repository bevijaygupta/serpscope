# Copy to .env before running Docker Compose or local services.
# Never commit real credentials or vendor API keys.

APP_NAME=SERPScope
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-value-in-production

# Local (non-Docker) default. Compose overrides this with an absolute container path.
DATABASE_URL=sqlite:///./data/serpscope.db
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports

ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Self-registration is dev/local only by default; opt in explicitly if needed.
# ALLOW_SELF_REGISTRATION=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
JOB_POLL_SECONDS=0.5
RUN_JOBS_IN_API=true
MAX_UPLOAD_MB=50
LOG_LEVEL=INFO

# Dormant live vendor connectors. Leave OFF until real credentials are available.
# Never commit real keys/tokens; supply them as deployment secrets instead.
# LIVE_CONNECTORS_ENABLED=false
# GSC_CLIENT_ID=
# GSC_CLIENT_SECRET=
# GSC_REDIRECT_URI=
# GSC_SITE_URL=
# GA4_CLIENT_ID=
# GA4_CLIENT_SECRET=
# GA4_REDIRECT_URI=
# GA4_PROPERTY_ID=
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# VENDOR_REQUEST_TIMEOUT_SECONDS=15
# VENDOR_MAX_ROWS=1000
